{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "labels": ["dependencies"],
  "packageRules": [
    {
      "description": "Group all non-major npm updates into a single PR weekly",
      "matchDatasources": ["npm"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "npm dependencies (non-major)",
      "schedule": ["before 8am on Monday"]
    },
    {
      "description": "Major updates as individual PRs for review",
      "matchDatasources": ["npm"],
      "matchUpdateTypes": ["major"],
      "groupName": null
    },
    {
      "description": "Auto-merge patch updates if CI passes",
      "matchUpdateTypes": ["patch"],
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": true
    }
  ],
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": ["security"]
  }
}
